<Project>

  <!-- NuGet audit: high/critical advisories break the build in CI only, so a
       new advisory published mid-session never blocks local work. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- MinVer: git tags must use uppercase V prefix, e.g. V1.0.0 -->
    <MinVerTagPrefix>V</MinVerTagPrefix>

    <!-- Shared package metadata -->
    <Authors>Carpe Diem Systems</Authors>
    <Company>Carpe Diem Systems</Company>
    <Copyright>Copyright © Carpe Diem Systems 2026</Copyright>
    <RepositoryUrl>https://github.com/nooogle/CDS.ImageDisplay.OpenCvSharp4</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/nooogle/CDS.ImageDisplay.OpenCvSharp4</PackageProjectUrl>

    <!-- Reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

	  <ApplicationVisualStyles>true</ApplicationVisualStyles>
	  <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
	  <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
	  <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
	  
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="5.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
